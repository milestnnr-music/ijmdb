# Python caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# Local secrets
.env
frontend/.streamlit/secrets.toml

# macOS
.DS_Store

# Temporary CSV extracts, kept on this machine
flatfiles/

submit50:
  files: &submit50_files
    - !exclude "__pycache__"
    - !exclude "node_modules"
    - !exclude "venv"
    - !require DESIGN.md
    - !require schema.sql
    - !require queries.sql
  style: false

check50:
  files: *submit50_files